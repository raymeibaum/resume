{
  "name": "resume",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tailwindcss -i ./css/input.css -o ./css/style.css --watch --minify\" \"live-server --watch=index.html,css/style.css\" \"node scripts/watch-pdf.js\"",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "build:pdf": "node scripts/generate-pdf.js",
    "build": "npm run build:css && npm run build:pdf"
  },
  "dependencies": {
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "live-server": "^1.2.0",
    "puppeteer": "^25.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymeibaum/resume.git"
  },
  "keywords": [],
